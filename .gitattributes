# Normalize text to LF in the repo and in the working copy, regardless of core.autocrlf
* text=auto eol=lf

# Windows-only scripts need CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets
*.jpg    binary
*.jpeg   binary
*.png    binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.pptx   binary
*.glb    binary
*.bin    binary
*.hdr    binary
*.bundle binary
